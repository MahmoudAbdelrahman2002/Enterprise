{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "Jwt": {
    "SecretKey": "",
    "Issuer": "Enterprise.Api",
    "Audience": "Enterprise.Client",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "AccountLockout": {
    "MaxFailedAccessAttempts": 5,
    "LockoutDurationMinutes": 15
  },
  "SeedData": {
    "AdminEmail": "",
    "AdminPassword": "",
    "AdminFirstName": "",
    "AdminLastName": ""
  },
  "Otp": {
    "Length": 6,
    "ExpirationMinutes": 10,
    "MaxAttempts": 5
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "User": "",
    "Password": "",
    "From": "noreply@enterprise.local",
    "Encryption": "tls",
    "CheckCertificateRevocation": true
  },
  "DashboardUrls": {
    "Admin": "http://localhost:4200/admin/login",
    "Provider": "http://localhost:4200/provider/login"
  },
  "ExternalAuth": {
    "Google": {
      "ClientIds": [ "YOUR_GOOGLE_WEB_OR_MOBILE_CLIENT_ID" ]
    },
    "Facebook": {
      "AppId": "YOUR_FACEBOOK_APP_ID",
      "AppSecret": "YOUR_FACEBOOK_APP_SECRET"
    }
  },
  "BlobStorage": {
    "ConnectionString": "",
    "ContainerName": "media",
    "PublicBaseUrl": ""
  },
  "Stripe": {
    "SecretKey": "",
    "PublishableKey": "",
    "WebhookSecret": "",
    "Currency": "usd",
    "SuccessUrl": "",
    "CancelUrl": ""
  },
  "Firebase": {
    "CredentialsPath": "",
    "CredentialsJson": ""
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Hangfire": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithProcessId" ],
    "WriteTo": [
      { "Name": "Console" }
    ]
  }
}
